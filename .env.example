# ==========================================
# Configuration de l'Application
# ==========================================
PROJECT_NAME="AIRH module analyse de CV -API"
VERSION="1.5"

# ==========================================
# Securité
# ==========================================
INTERNAL_API_KEY="votre_cle_secrete_interne"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ==========================================
# Configuration du LLM (Switch via Instructor)
# ==========================================
# Modèle des agents (Couche 3)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
# Couche 1 (extraction structurée) : un petit modèle économique suffit.
# Si non précisé, retombe sur DEFAULT_LLM_PROVIDER / DEFAULT_LLM_MODEL.
# Exemples : gpt-4o-mini (openai) ou mistral-small-latest (mistral)
LAYER1_LLM_PROVIDER=openai
LAYER1_LLM_MODEL=gpt-4o-mini
# Vision (fallback lecture en-tête CV) : gpt-4o-mini suffit largement
VISION_LLM_PROVIDER=openai
VISION_LLM_MODEL=gpt-4o-mini

# Clés d'API (À remplacer)
OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=...
GROQ_API_KEY=...

# ==========================================
# Configuration Base de données (PostgreSQL)
# ==========================================
POSTGRES_USER=votre_user
POSTGRES_PASSWORD=votre_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=votre_db

# ==========================================
# Observabilité
# ==========================================
LANGTRACE_API_KEY=...
CREWAI_TRACING_ENABLED=true

# ==========================================
# Limites & Timeouts
# ==========================================
LAYER1_TIMEOUT_SECONDS=60
LAYER2_TIMEOUT_SECONDS=2
LAYER3_TIMEOUT_SECONDS=180
MAX_FILE_SIZE_MB=5
PORT=8000
